<Project Sdk="Cosmos.Sdk/3.0.95">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The generated entry point (CosmosEntryPoint.Main) constructs and starts this class -->
    <CosmosKernelClass>NewElf.Kernel.NewElfKernel</CosmosKernelClass>
    <AssemblyName>NewElf.Kernel</AssemblyName>
    <RootNamespace>NewElf.Kernel</RootNamespace>
    <!-- AllowUnsafeBlocks, Nullable and ImplicitUsings are already enabled by Cosmos.Sdk -->
  </PropertyGroup>

  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.95" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.95" />
  </ItemGroup>

</Project>

CC = gcc
# The kernel runs in long mode (x86-64, SysV ABI), so the ELF is built as a
# 64-bit static PIE. A static PIE only needs R_X86_64_RELATIVE relocations,
# which the loader applies at load time, so the binary can run from any
# heap address.
# -mno-red-zone: the ELF runs with interrupts enabled on the kernel stack.
# -fno-stack-protector: no libgcc/ssp support in a freestanding build.
CFLAGS = -m64 -mno-red-zone -ffreestanding -fno-stack-protector -fno-builtin \
	 -nostdlib -fPIE -O0 -g -Wno-discarded-qualifiers -Wno-attributes -I./include
LDFLAGS = -m64 -static-pie -nostdlib -Wl,--build-id=none -Wl,-z,noexecstack -Wl,-e,_start -O0 -g -I./include
OUTPUT = TestElf

# Where the kernel project picks the binary up from
KERNEL_ELF_DIR = ../NewElf.Kernel/Drivers/ELF
EMBED_FILE = $(KERNEL_ELF_DIR)/TestElfBytes.cs

SOURCES = $(wildcard *.c)
OBJECTS = $(SOURCES:.c=.o)

all: $(OUTPUT)

$(OUTPUT): $(SOURCES)
	$(CC) $(CFLAGS) $(LDFLAGS) $(SOURCES) -o $(OUTPUT)

build: $(OUTPUT)
	cp $(OUTPUT) $(KERNEL_ELF_DIR)/$(OUTPUT)
	-strip $(KERNEL_ELF_DIR)/$(OUTPUT) 2>/dev/null || true

# Rebuilds the C# byte array the kernel embeds (there is no
# ManifestResourceStream support, so the test ELF ships as TestElfBytes.cs).
embed: build
	@printf '// <auto-generated by "make embed" in CosmosExec - do not edit manually/>\nnamespace NewElf.Drivers.ELF;\n\npublic static class TestElfBytes\n{\n    public static readonly byte[] TestElf =\n    {\n' > $(EMBED_FILE)
	@od -An -v -tu1 $(KERNEL_ELF_DIR)/$(OUTPUT) | awk '{ line = ""; for (i = 1; i <= NF; i++) line = line " " $$i ","; printf "       %s\n", line }' >> $(EMBED_FILE)
	@printf '    };\n}\n' >> $(EMBED_FILE)
	@echo "Wrote $(EMBED_FILE)"

clean:
	rm -f $(OUTPUT) $(OBJECTS)
